# CFO Copilot - Environment Configuration
#
# This file contains example values only.
# Copy to .env and replace credentials before shared deployment.
# Never commit the actual .env file.

# Docker Compose MySQL credentials
MYSQL_DATABASE=cfo_copilot
MYSQL_USER=cfo_user
MYSQL_PASSWORD=change_this_local_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Host-side Python configuration
# When running Python directly on Windows, use localhost:3306
DATABASE_URL=mysql+pymysql://cfo_user:change_this_local_password@127.0.0.1:3306/cfo_copilot

# Local model configuration
# Docker Compose currently configures Ollama separately.
CFO_MODEL=ollama_chat/llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
MODEL_CONTEXT_TOKENS=8192

# Request handling
MAX_CONCURRENT_REQUESTS=16
MAX_QUEUED_REQUESTS=32
QUEUE_WAIT_TIMEOUT_SECONDS=1
